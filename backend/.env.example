# StoryForge AI Environment Configuration

# Server
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Database (SQLite by default; easily swapped to PostgreSQL)
DATABASE_URL=sqlite:///./storyforge.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/storyforge

# Authentication (JWT)
SECRET_KEY=storyforge_super_secret_jwt_key_change_in_production_min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / Ollama Service
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:latest
OLLAMA_TIMEOUT_SECONDS=60

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
